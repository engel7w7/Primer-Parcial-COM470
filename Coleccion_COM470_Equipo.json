{
  "info": {
    "_postman_id": "c1a2b3c4-d5e6-7890-1234-56789abcdef0",
    "name": "COM470 - API Testing Unitario",
    "description": "Colección colaborativa para validación E2E. Dividida por responsabilidades (Jhojan e Ismael).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Parte 1: Lógica Transaccional (Jhojan)",
      "item": [
        {
          "name": "1. Transferencia Exitosa",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"El JSON confirma la transferencia\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.mensaje).to.eql(\"Transferencia realizada con éxito\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/cuentas/transferir?origen=1&destino=2&monto=100&bancoId=1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "cuentas", "transferir"],
              "query": [
                {"key": "origen", "value": "1"},
                {"key": "destino", "value": "2"},
                {"key": "monto", "value": "100"},
                {"key": "bancoId", "value": "1"}
              ]
            }
          }
        },
        {
          "name": "2. Transferencia Fallida (Sin Fondos)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Falla esperada por DineroInsuficienteException (Status 500)\", function () {",
                  "    pm.response.to.have.status(500);",
                  "});",
                  "pm.test(\"El mensaje de error contiene validación de negocio\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"Dinero insuficiente\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/cuentas/transferir?origen=1&destino=2&monto=1200&bancoId=1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "cuentas", "transferir"],
              "query": [
                {"key": "origen", "value": "1"},
                {"key": "destino", "value": "2"},
                {"key": "monto", "value": "1200"},
                {"key": "bancoId", "value": "1"}
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Parte 2: Consultas y Auditoría (Ismael)",
      "item": [
        {
          "name": "3. Consultar Saldo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"El JSON retorna el saldo numérico de la cuenta\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('saldo');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/cuentas/1/saldo",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "cuentas", "1", "saldo"]
            }
          }
        },
        {
          "name": "4. Buscar Cuenta por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Se retorna la entidad Cuenta con nombre y saldo\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.persona).to.eql(\"Andrés\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/cuentas/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "cuentas", "1"]
            }
          }
        },
        {
          "name": "5. Auditoría: Total Transferencias Banco",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"El banco retorna el historial de transferencias\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('totalTransferencias');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/bancos/1/transferencias",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "bancos", "1", "transferencias"]
            }
          }
        }
      ]
    }
  ]
}