    "name": "COM470 - API Testing Unitario (Primer Parcial - Grupo 1)",
    "description": "Colección colaborativa para validación E2E en COM470 (Prueba y Mantenimiento de Software - USFX). Trazabilidad de Historias de Usuario (HU) y Casos de Prueba (CP) entre Jhojan Romero e Ismael Garcia.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Parte 1: Lógica Transaccional (Jhojan Romero)",
      "item": [
        {
          "name": "HU-08 / CP-08: Transferencia Exitosa (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"El JSON confirma la transferencia\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.mensaje).to.eql(\"Transferencia realizada con éxito\");",
                  "    pm.expect(jsonData.origen).to.eql(1);",
                  "    pm.expect(jsonData.destino).to.eql(2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/cuentas/transferir?origen=1&destino=2&monto=100&bancoId=1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "cuentas", "transferir"],
              "query": [
                {"key": "origen", "value": "1"},
                {"key": "destino", "value": "2"},
                {"key": "monto", "value": "100"},
                {"key": "bancoId", "value": "1"}
              ]
            }
          }
        },
        {
          "name": "HU-09 / CP-02: Transferencia Fallida - Fondos Insuficientes (Status 500)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Falla esperada por DineroInsuficienteException (Status 500)\", function () {",
                  "    pm.response.to.have.status(500);",
                  "});",
                  "pm.test(\"El mensaje de error contiene validación de negocio\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"Dinero insuficiente\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/cuentas/transferir?origen=1&destino=2&monto=1200&bancoId=1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "cuentas", "transferir"],
              "query": [
                {"key": "origen", "value": "1"},
                {"key": "destino", "value": "2"},
                {"key": "monto", "value": "1200"},
                {"key": "bancoId", "value": "1"}
              ]
            }
          }
        },
        {
          "name": "HU-03 / CP-03: Transferencia Fallida - Monto Negativo Bug BC001 (Status 500)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Falla esperada por IllegalArgumentException (Status 500)\", function () {",
                  "    pm.response.to.have.status(500);",
                  "});",
                  "pm.test(\"El mensaje de error rechaza montos negativos o cero\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"El monto no puede ser negativo ni cero\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/cuentas/transferir?origen=1&destino=2&monto=-100&bancoId=1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "cuentas", "transferir"],
              "query": [
                {"key": "origen", "value": "1"},
                {"key": "destino", "value": "2"},
                {"key": "monto", "value": "-100"},
                {"key": "bancoId", "value": "1"}
              ]
            }
          }
        }
      ]
    },
    {
